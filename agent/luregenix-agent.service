[Unit]
Description=LureGenix honeytoken deployment and monitoring agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/luregenix-agent.env
ExecStart=/opt/luregenix-agent/venv/bin/python /opt/luregenix-agent/agent.py
User=root
Group=root
UMask=0077
StateDirectory=luregenix-agent
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc /home /opt /var/lib/luregenix-agent -/var/www
ReadOnlyPaths=/opt/luregenix-agent /etc/luregenix-agent.env
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
PrivateDevices=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER

[Install]
WantedBy=multi-user.target
