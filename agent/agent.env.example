GATEWAY_URL=http://127.0.0.1:8080
AGENT_SECRET=
NODE_HOSTNAME=
NODE_IP=
AGENT_ALLOWED_DIRS=/etc,/var/www,/home,/opt
AGENT_AUTO_DIRS=/var/www/html,/var/www,/opt,/home,/etc
AGENT_STATE_FILE=/var/lib/luregenix-agent/agent.json
HEARTBEAT_INTERVAL=60
TASK_POLL_INTERVAL=10
AGENT_FILE_MODE=0644
# For a private certificate authority, set a readable PEM CA bundle path.
AGENT_CA_FILE=
